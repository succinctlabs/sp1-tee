[Unit]
Description=SP1 TEE Signers Stub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
ExecStart=/home/ec2-user/.cargo/bin/sp1-tee-signers-stub --address 0.0.0.0 --port 8080
Restart=always
RestartSec=5s
Environment=RUST_LOG=info
# install-stub.sh substitutes the placeholders at deploy time. AWS_REGION
# is pinned explicitly so the snapshot S3 client never falls back to a
# wrong default if EC2 IMDS is briefly unreachable at startup.
Environment=SP1_TEE_SNAPSHOTS_BUCKET=__SP1_TEE_SNAPSHOTS_BUCKET__
Environment=AWS_REGION=__AWS_REGION__

[Install]
WantedBy=multi-user.target
